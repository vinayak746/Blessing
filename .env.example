# Blessing environment configuration
# Copy this file to .env and replace placeholders with your own values.
# Never commit .env or put real secrets in this file.

# Required: PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/blessing?schema=public"

# Required for encrypting/decrypting saved workflow credentials.
# Keep this secret stable: changing it can make existing credentials unreadable.
ENCRYPTION_KEY="replace-with-your-own-secret"

# OAuth providers (needed for the corresponding sign-in methods)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# Polar billing integration (needed for billing/checkout features)
POLAR_ACCESS_TOKEN="your-polar-access-token"
POLAR_SUCCESS_URL="http://localhost:3000/replace-with-your-success-path"

# Email/notification service (needed when the mail-sending service is used)
QSTASH_TOKEN="your-qstash-token"
MAILER_URL="https://your-mailer-service.example"

# Newsletter integration; the application code has a fallback if this is unset
NEWSLETTER_BASE_URL="https://your-newsletter-service.example"

# Public application URL, where used
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: used by the ngrok:dev script / local dev:all setup
NGROK_URL="https://your-ngrok-domain.ngrok-free.app"

# Optional: referenced by the application for admin-related behavior
ADMIN_EMAIL="admin@example.com"
